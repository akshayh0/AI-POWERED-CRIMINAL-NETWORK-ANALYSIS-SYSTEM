# Server Port (Render sets this dynamically)
PORT=5000

# Frontend origin allowed for CORS (e.g. Netlify deployment URL)
# For local development: http://localhost:5173
# For production: https://YOUR-NETLIFY-APP.netlify.app
FRONTEND_URL=http://localhost:5173

# Optional custom path for SQLite database file
# Default lookup checks ./crime_intelligence.db in backend directory
DATABASE_PATH=crime_intelligence.db

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

